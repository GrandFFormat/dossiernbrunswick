{
  "name": "dossiernbrunswick",
  "version": "0.1.0",
  "private": true,
  "description": "Scrapers et pages de DossierNBrunswick, la veille citoyenne de l'Assemblée législative du Nouveau-Brunswick",
  "type": "module",
  "scripts": {
    "refresh": "node scripts/refresh.js",
    "scrape:bills": "node scrapers/bills.js",
    "scrape:resumes": "node --env-file-if-exists=api.env scrapers/nb-resumes.js",
    "scrape:deputes": "node scrapers/deputes.js",
    "scrape:depute-emails": "node scrapers/depute-emails.js",
    "scrape:ministers": "node scrapers/ministers.js",
    "scrape:votes": "node scrapers/votes.js",
    "scrape:calendrier": "node scrapers/calendrier.js",
    "build:frontend": "node scrapers/build-frontend-data.js",
    "build:deputes": "node scrapers/build-deputes-data.js",
    "build:depute-emails": "node scrapers/build-depute-emails-data.js",
    "build:votes": "node scrapers/build-votes-data.js",
    "build:ministers": "node scrapers/build-ministers-data.js",
    "build:pages": "node scripts/build-section-pages.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "cheerio": "^1.0.0",
    "csv-parse": "^5.6.0",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}
